{
  "manifest_version": 3,
  "name": "CareerOps Share",
  "short_name": "CareerOps Share",
  "version": "0.1.0",
  "description": "Capture a job posting and prepare a reviewable CareerOps v1.0 analysis or application-artifact request.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "Capture job with CareerOps Share",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+J"},
      "description": "Open CareerOps Share job capture"
    }
  }
}
